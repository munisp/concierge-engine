{
  "$id": "resolve_client.schema.json",
  "tool": "resolve_client",
  "description": "Phone/email/name match to existing profile; creates draft profile if new. Returns confidence; low confidence -> ask, never guess.",
  "parameters": {
    "type": "object",
    "properties": {
      "tenant_id": {
        "type": "string"
      },
      "phone": {
        "type": "string"
      },
      "email": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "channel": {
        "type": "string"
      }
    },
    "required": [
      "tenant_id"
    ]
  },
  "returns": {
    "type": "object",
    "properties": {
      "client_id": {
        "type": "string"
      },
      "confidence": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "is_new": {
        "type": "boolean"
      },
      "vip_flagged": {
        "type": "boolean"
      }
    },
    "required": [
      "client_id",
      "confidence"
    ]
  }
}